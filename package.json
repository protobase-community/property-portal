{
  "name": "property-portal",
  "version": "0.0.0",
  "description": "A property portal built with Protobase: public listings with map, saved searches with email alerts and favorites",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/protobase-community/property-portal.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "db:up": "test -f .env || cp .env.example .env; docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "bun db/migrate.ts",
    "db:seed": "bun seed/cli.ts",
    "db:reset": "bun db/drop.ts && bun db/migrate.ts && bun seed/cli.ts --scale small",
    "map:tiles": "bun map/tiles.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "protobase": "protobase",
    "build": "protobase build",
    "serve": "protobase build && protobase serve dist",
    "dev": "protobase dev"
  },
  "dependencies": {
    "@protobase/cli": "0.45.9",
    "@protobase/layout": "0.45.9",
    "@protobase/schema": "0.45.9",
    "@protobase/server": "0.45.9",
    "@protobase/ui": "0.45.9",
    "better-auth": "^1.7.12",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-email": "^6.11.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
