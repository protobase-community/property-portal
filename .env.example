# The property portal example's own settings. The nearest .env wins, so this file is the one
# `protobase dev`, `protobase serve` and the db:* scripts read here. The Postgres container is docker-compose.yml's (`bun run db:up`).
DATABASE_URL=postgres://protobase:protobase@localhost:55435/property_portal

# Admin store (Better Auth users, sessions, signing keys): the `auth` schema of DATABASE_URL, created by `db:migrate`.
PROTOBASE_URL=http://localhost:5173
# Signs cookies and encrypts the token keys. Generate your own: openssl rand -base64 32
PROTOBASE_SECRET=change-me-generate-with-openssl-rand-base64-32
# PROTOBASE_TRUSTED_ORIGINS=

# Search alert mail and sign-up codes: the SMTP server and the sender. Without them alerts still show in the app, nothing
# is mailed, and the sign-in page offers no "Create an account".
# PROTOBASE_SMTP_URL=smtp://localhost:1025
# PROTOBASE_MAIL_FROM=alerts@portal.example.com

# The listing page's map: a MapLibre style URL. This one is OpenFreeMap's, the whole world, free and without a key, for
# development. `bun run map:tiles` serves another at http://localhost:8790/style.json, the Benelux and the British Isles
# only. Point it at your own self-hosted style and PMTiles; without it the app draws no map.
PROTOBASE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
